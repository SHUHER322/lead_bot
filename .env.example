# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token
# Куда слать заявки и отчёты: chat id менеджера (узнать у @userinfobot).
# Несколько менеджеров — через запятую: 123456789,987654321
MANAGER_CHAT_ID=123456789
DB_PATH=leads.db

# Google Таблица (необязательно — без SPREADSHEET_ID выгрузка отключена)
# Ключ сервисного аккаунта Google
GOOGLE_CREDENTIALS=credentials.json
# ID таблицы: часть адреса между /d/ и /edit
SPREADSHEET_ID=

# Часовой пояс заказчика и время ежедневного отчёта (по этому поясу)
TIMEZONE=Asia/Tomsk
REPORT_TIME=20:00

# Категории заявок через запятую — показываются клиенту кнопками
CATEGORIES=Ремонт,Консультация,Сотрудничество,Другое
